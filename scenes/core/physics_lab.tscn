[gd_scene load_steps=12 format=3]

; Tuning bench. Fire a shot, watch the arc, read the prediction error.
; Not a shipped scene - main.tscn is still the project's main scene.

[ext_resource type="Script" path="res://scripts/gameplay/physics_lab.gd" id="1_lab"]
[ext_resource type="PackedScene" path="res://scenes/court/court.tscn" id="2_court"]
[ext_resource type="PackedScene" path="res://scenes/ball/ball.tscn" id="3_ball"]
[ext_resource type="Script" path="res://scripts/gameplay/debug_free_camera.gd" id="4_camera"]
[ext_resource type="Resource" path="res://resources/surfaces/hard_court.tres" id="5_hard"]
[ext_resource type="Resource" path="res://resources/surfaces/clay_court.tres" id="6_clay"]
[ext_resource type="Resource" path="res://resources/surfaces/grass_court.tres" id="7_grass"]
[ext_resource type="Resource" path="res://resources/surfaces/indoor_court.tres" id="8_indoor"]

[sub_resource type="Environment" id="Env_lab"]
background_mode = 1
background_color = Color(0.36, 0.51, 0.66, 1)
ambient_light_source = 2
ambient_light_color = Color(0.55, 0.6, 0.66, 1)
ambient_light_energy = 0.65

[sub_resource type="TorusMesh" id="Torus_ring"]
inner_radius = 0.28
outer_radius = 0.38
rings = 24
ring_segments = 8

[sub_resource type="StandardMaterial3D" id="Mat_ring"]
transparency = 1
shading_mode = 0
albedo_color = Color(0.2, 0.9, 0.35, 0.85)

[node name="PhysicsLab" type="Node3D"]
script = ExtResource("1_lab")
surfaces = Array[Resource]([ExtResource("5_hard"), ExtResource("6_clay"), ExtResource("7_grass"), ExtResource("8_indoor")])

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_lab")

; CLAUDE.md section 8 allows exactly one directional light and no others.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5736, -0.8192, 0, 0.8192, 0.5736, 0, 12, 6)
shadow_enabled = true

[node name="Court" parent="." instance=ExtResource("2_court")]

[node name="Ball" parent="." instance=ExtResource("3_ball")]

[node name="LandingRing" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.01, 0)
mesh = SubResource("Torus_ring")
cast_shadow = 0
surface_material_override/0 = SubResource("Mat_ring")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.9659, -0.2588, 0, 0.2588, 0.9659, 0, 6, 20)
current = true
far = 200.0
script = ExtResource("4_camera")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Stats" type="Label" parent="UI"]
offset_left = 16.0
offset_top = 8.0
offset_right = 900.0
offset_bottom = 34.0
mouse_filter = 2
text = "--"

[node name="Panel" type="PanelContainer" parent="UI"]
offset_left = 16.0
offset_top = 44.0
offset_right = 536.0
offset_bottom = 360.0

[node name="VBox" type="VBoxContainer" parent="UI/Panel"]
