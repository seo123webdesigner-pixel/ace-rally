[gd_scene load_steps=9 format=3]

; The ball. A plain Node3D, never a RigidBody3D - see CLAUDE.md section 3 rule 1.
;
; The sphere is authored at the REAL radius of 0.0335 m and inflated by the
; script to visual_radius, so the true dimension stays visible in the file and the
; cheat is in one named place. The simulator reads BallPhysicsConfig.radius and is
; entirely unaware of the mesh.

[ext_resource type="Script" path="res://scripts/gameplay/ball.gd" id="1_ball"]
[ext_resource type="Resource" path="res://resources/ball_physics_default.tres" id="2_physics"]
[ext_resource type="Resource" path="res://resources/surfaces/hard_court.tres" id="3_surface"]

[sub_resource type="SphereMesh" id="SphereMesh_ball"]
radius = 0.0335
height = 0.067
radial_segments = 16
rings = 8

[sub_resource type="StandardMaterial3D" id="Mat_ball"]
albedo_color = Color(0.85, 0.93, 0.2, 1)
roughness = 0.85

[sub_resource type="PlaneMesh" id="PlaneMesh_shadow"]
size = Vector2(0.3, 0.3)

[sub_resource type="StandardMaterial3D" id="Mat_shadow"]
transparency = 1
shading_mode = 0
albedo_color = Color(0, 0, 0, 0.35)

[sub_resource type="ParticleProcessMaterial" id="Particle_trail"]
particle_flag_disable_z = false
gravity = Vector3(0, 0, 0)
scale_min = 0.3
scale_max = 0.6

[sub_resource type="StandardMaterial3D" id="Mat_trail"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(0.95, 0.97, 0.6, 0.5)

[node name="Ball" type="Node3D"]
script = ExtResource("1_ball")
physics_config = ExtResource("2_physics")
surface = ExtResource("3_surface")
visual_radius = 0.05

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("SphereMesh_ball")
surface_material_override/0 = SubResource("Mat_ball")

[node name="Shadow" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.007, 0)
mesh = SubResource("PlaneMesh_shadow")
cast_shadow = 0
surface_material_override/0 = SubResource("Mat_shadow")

; Fixed amount, allocated once, only ever toggled by emitting. This is the pool
; CLAUDE.md section 8 asks for; nothing is instantiated during a rally.
[node name="Trail" type="GPUParticles3D" parent="."]
emitting = false
amount = 48
lifetime = 0.45
local_coords = false
process_material = SubResource("Particle_trail")
draw_pass_1 = SubResource("SphereMesh_ball")
material_override = SubResource("Mat_trail")
